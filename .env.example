# ============================================================
# Modelo de configuracao do DualFlux Central.
# Copie para ".env" e troque os valores "troque-...".
# Este arquivo (.env.example) VAI para o Git: nao coloque senhas reais aqui.
# ============================================================

# --- Django ---
# DEBUG=True mostra erros detalhados no navegador: so no notebook.
# No VPS sera sempre False (erros detalhados revelam o codigo a um invasor).
DJANGO_DEBUG=True

# Chave usada pelo Django para assinar sessoes de login e cookies.
# Cada ambiente (notebook, homologacao, producao) tem a sua.
DJANGO_SECRET_KEY=troque-esta-chave

# Enderecos pelos quais o site pode ser acessado (separados por virgula).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados (PostgreSQL) ---
# Os mesmos valores sao usados pelo container do banco (para criar o banco)
# e pelo Django (para se conectar a ele): uma unica fonte, sem repetir senha.
POSTGRES_DB=dualflux_central
POSTGRES_USER=dualflux_app
POSTGRES_PASSWORD=troque-esta-senha

# "db" e o nome do servico do banco no compose.yaml: dentro da rede do Docker,
# os containers se encontram pelo nome, nao por IP.
POSTGRES_HOST=db
POSTGRES_PORT=5432